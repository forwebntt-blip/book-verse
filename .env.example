NODE_ENV=development
PORT=3000
APP_NAME=Bookverse
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookverse?schema=public
SESSION_SECRET=change-me-before-production
SESSION_TABLE_NAME=sessions
SESSION_COOKIE_NAME=bookverse.sid
SESSION_TTL_SECONDS=604800
ENABLE_SECURE_COOKIES=false
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
ANALYTICS_RELAY_ENABLED=false
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
BANK_TRANSFER_BANK_NAME=Vietcombank
BANK_TRANSFER_ACCOUNT_NUMBER=1234567890
BANK_TRANSFER_ACCOUNT_NAME=BOOKVERSE JSC
BANK_TRANSFER_NOTE_PREFIX=BOOKVERSE
