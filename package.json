{
  "name": "duan3",
  "version": "1.0.0",
  "description": "Production-oriented modular monolith skeleton for the bookstore platform.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "tsx src/server.ts",
    "clean": "node scripts/clean.mjs",
    "build": "npm run build:server",
    "build:server": "tsc --project tsconfig.json",
    "start": "node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:cleanup:test-data": "tsx prisma/cleanup-test-data.ts",
    "prisma:studio": "prisma studio",
    "test:preflight": "node scripts/preflight.mjs",
    "test:smoke": "node scripts/smoke-local.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "test:part1-5": "tsx tests/manual/run-part1-5-selftest.ts",
    "test:part6": "tsx tests/manual/run-part6-selftest.ts",
    "test:part7": "tsx tests/manual/run-part7-selftest.ts",
    "test:part8": "tsx tests/manual/run-part8-selftest.ts",
    "test:acceptance": "npm run test:part1-5 && npm run test:part6 && npm run test:part7 && npm run test:part8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-sync": "^4.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "http-errors": "^2.0.1",
    "morgan": "^1.10.1",
    "pg": "^8.20.0",
    "prisma": "^7.8.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
